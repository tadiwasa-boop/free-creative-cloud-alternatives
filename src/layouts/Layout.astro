---
const { title = "50 Best Free Alternatives to Adobe Creative Cloud", description = "A practical directory of free and freemium alternatives to Adobe Creative Cloud." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #172033; background: #f7f8fb; }
    * { box-sizing: border-box; }
    body { margin: 0; line-height: 1.6; }
    a { color: inherit; }
    .wrap { max-width: 1120px; margin: auto; padding: 0 20px; }
    header { padding: 72px 0 48px; background: #111827; color: white; }
    header h1 { font-size: clamp(2.3rem, 6vw, 4.6rem); line-height: 1; margin: 0 0 18px; letter-spacing: -0.05em; }
    header p { max-width: 720px; font-size: 1.1rem; color: #cbd5e1; }
    .pill { display:inline-block; padding: 6px 10px; border-radius: 999px; background:#e8edf7; font-size:.78rem; margin: 3px 3px 3px 0; }
    .grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(310px,1fr)); gap:18px; padding: 34px 0; }
    .card { background:white; border:1px solid #e4e8ef; border-radius:18px; padding:24px; box-shadow:0 8px 30px rgba(15,23,42,.04); }
    .card h2 { margin:0 0 5px; font-size:1.35rem; }
    .meta { color:#64748b; font-size:.9rem; margin-bottom:14px; }
    .card p { color:#334155; }
    .button { display:inline-block; margin-top:10px; padding:10px 14px; border-radius:10px; background:#111827; color:white; text-decoration:none; font-weight:700; }
    .notice { background:#fff7ed; border:1px solid #fed7aa; padding:16px 18px; border-radius:14px; margin-top:28px; color:#7c2d12; }
    footer { padding:40px 0 60px; color:#64748b; font-size:.9rem; }
  </style>
</head>
<body><slot /></body>
</html>
