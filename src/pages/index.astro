---
import Layout from "../layouts/Layout.astro";
import { tools } from "../data/tools";
const categories = [...new Set(tools.map(t => t.category))].sort();

function getLogo(url) {
  const domain = new URL(url).hostname;
  return `https://www.google.com/s2/favicons?sz=128&domain=${domain}`;
}
---
<Layout>
  <header>
    <div class="wrap">
      <p>THE INDEPENDENT CREATOR TOOL DIRECTORY</p>
      <h1>50 Best Free Alternatives to Adobe Creative Cloud</h1>
      <p>Find free and freemium tools for photo editing, video, illustration, animation, audio, publishing and more. No Creative Cloud subscription required.</p>
    </div>
  </header>
  <main class="wrap">
    <div class="notice">
      <strong>Affiliate disclosure:</strong> Some links on this site may eventually be affiliate links. We only add affiliate links after confirming the relevant program and terms. Until then, links go to official product websites.
    </div>
    <section>
      <h2>Browse the directory</h2>
      <p id="count">{tools.length} tools and workflows across {categories.length} categories.</p>

      <div class="filters">
        <input type="text" id="search" placeholder="Search tools..." />
        <select id="category">
          <option value="">All categories</option>
          {categories.map((cat) => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
      </div>

      <div class="grid" id="grid">
        {tools.map((tool) => (
          <article class="card" data-name={tool.name.toLowerCase()} data-category={tool.category} data-review={tool.review.toLowerCase()}>
            <img class="logo" src={getLogo(tool.url)} alt={`${tool.name} logo`} loading="lazy" />
            <h2>{tool.name}</h2>
            <div class="meta">Alternative to {tool.adobe} · {tool.category}</div>
            <span class="pill">{tool.pricing}</span>
            <span class="pill">{tool.platforms}</span>
            <p>{tool.review}</p>
            <a class="button" href={tool.url} target="_blank" rel="noopener noreferrer">Visit official site →</a>
          </article>
        ))}
      </div>
      <p id="no-results" style="display:none;">No tools match your search.</p>
    </section>
  </main>
  <footer class="wrap">
    <p>Prices, features, licensing and availability can change. Verify current terms on each official product site before making purchasing or publishing decisions.</p>
  <p>Looking for free AI tools too? Check out <a href="https://claude.ai/artifact/5iM1sV1RDfgmEWnxcZXg5E" target="_blank" rel="noopener noreferrer">Skip the Subscription</a>.</p>
  </footer>

  <script>
    const search = document.getElementById("search");
    const category = document.getElementById("category");
    const cards = document.querySelectorAll(".card");
    const noResults = document.getElementById("no-results");

    function filterCards() {
      const term = search.value.toLowerCase().trim();
      const cat = category.value;
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name;
        const review = card.dataset.review;
        const cardCat = card.dataset.category;

        const matchesSearch = !term || name.includes(term) || review.includes(term);
        const matchesCategory = !cat || cardCat === cat;

        if (matchesSearch && matchesCategory) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      noResults.style.display = visibleCount === 0 ? "block" : "none";
    }

    search.addEventListener("input", filterCards);
    category.addEventListener("change", filterCards);
  </script>
</Layout>
